{
  "name": "need-to-know",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@truefoundry/trueforge-sdk": "0.1.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify-receipt": "node --import ./scripts/register-ts-loader.mjs src/verify/cli.ts",
    "start-vault": "node --import ./scripts/register-ts-loader.mjs scripts/start-vault.ts",
    "setup-trueforge": "node --import ./scripts/register-ts-loader.mjs scripts/setup-trueforge.ts",
    "gate-a": "node --import ./scripts/register-ts-loader.mjs scripts/gate-a.ts",
    "gate-b": "node --import ./scripts/register-ts-loader.mjs scripts/gate-b.ts",
    "gate-c": "node --import ./scripts/register-ts-loader.mjs scripts/gate-c.ts",
    "reconnect-proof": "node --import ./scripts/register-ts-loader.mjs scripts/reconnect-proof.ts",
    "clean-run": "node --import ./scripts/register-ts-loader.mjs scripts/clean-run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
